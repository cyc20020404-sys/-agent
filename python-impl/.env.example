# LLM Provider
DASHSCOPE_API_KEY=your-api-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen3.7-plus

# Redis (短期记忆)
REDIS_URL=redis://localhost:6379/0

# Vector Store (长期记忆)
VECTOR_STORE_TYPE=faiss
FAISS_INDEX_PATH=./vector_store/faiss_index
# MILVUS_HOST=localhost
# MILVUS_PORT=19530

# OpenTelemetry (全链路追踪)
OTEL_SERVICE_NAME=smart-cs-multi-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLER=always_on

# LangSmith (可选)
# LANGSMITH_API_KEY=ls-your-langsmith-key
# LANGSMITH_PROJECT=smart-cs-agent

# Server
HOST=0.0.0.0
PORT=8000

# Spring Boot 外卖后端
# BACKEND_BASE_URL=http://localhost:8080/admin
# BACKEND_TOKEN_HEADER=token

# MySQL (聊天记录持久化)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DATABASE=sky_take_out
# MYSQL_USER=root
# MYSQL_PASSWORD=123456
# MYSQL_POOL_SIZE=5




